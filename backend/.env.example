# EvoCode Agent 后端环境变量样例
# 复制为 .env 后按需修改；.env 不进版本库（.gitignore 已排除）

# 应用
APP_NAME="EvoCode Agent API"
APP_VERSION=0.1.0
ENV=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# 数据层（docker compose 起的本地基础设施默认值）
DATABASE_URL=postgresql+asyncpg://evocode:evocode@localhost:5432/evocode
DB_ECHO=false
DB_POOL_SIZE=5
REDIS_URL=redis://localhost:6379/0

# 向量库（P3 启用）
CHROMA_PERSIST_DIR=./data/chroma

# CORS（逗号分隔多个来源）
ALLOWED_ORIGINS=http://localhost:5173

# ── 敏感配置：只走环境变量，绝不入库（docs/08 决策 #4 / 额外检查 #7）──
# GLM 开放平台 API Key；P3 前留空，为空时 Agent 相关接口显式报错
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 应用层加密主键（未来如需在库内保存加密配置时启用；当前留空）
MASTER_KEY=
